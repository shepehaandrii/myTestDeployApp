name: Deploy

on:
  push:
    branches:
      - main

jobs:
  deploy:
    runs-on: ubuntu-latest

    steps:
      - name: Deploy via SSH
        uses: appleboy/ssh-action@master

        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ubuntu
          key: ${{ secrets.SERVER_SSH_KEY }}

          script: |
            cd /home/ubuntu/myTestDeployApp
            git pull origin main
            docker-compose down
            docker-compose up -d --build



#1 Створюємо ec2 інстанс на AWS з Ubuntu 20.04
#2 Підключаємось до інстансу через SSH
#3 Створюємо новий ssh ключ для підключення до інстансу та додаємо його до GitHub Secrets
#4 Встановлюємо Docker та Docker Compose на інстансі
#5 Створюємо папку для нашого проекту та ініціалізуємо git репозиторій
#6 Створюємо docker-compose.yml файл з двома сервісами: сервером та клієнтом
#7 Створюємо GitHub Actions workflow для автоматичного деплою на інстанс при пуші в гілку main
#8 Пушимо код на GitHub та перевіряємо, що деплой відбувся успішно, а додаток працює на інстансі.
#9 Ставимо nginx як реверс-проксі для нашого додатку, щоб він був доступний через порт 80.
#10 Налаштовуємо aws Elastic Ip для нашого інстансу, щоб він мав статичну IP адресу та був доступний навіть після перезавантаження інстансу.
#11 Налаштовуємо SSL сертифікат для нашого домену за допомогою Let's Encrypt та Certbot.
#12 Готово! Тепер наш додаток розгорнутий на AWS EC2 та доступний через інтернет.